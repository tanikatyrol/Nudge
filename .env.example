# ──────────────────────────────────────────────────────────────────────────────
# NUDGE — environment variables
# Copy this file to .env.local (local dev) and configure the same values in
# Vercel → Project → Settings → Environment Variables for production.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service-role key — SERVER ONLY. Used by the cron dispatcher and account
# deletion. Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Push notifications (required for reminders) ──────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
# The public key is safe to expose to browsers (it is sent to clients).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
# Contact info sent to push services, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:hello@nudge.example.com

# ── Cron dispatcher (required in production) ─────────────────────────────────
# Any long random string. Vercel Cron automatically sends it as
# "Authorization: Bearer <CRON_SECRET>" when this env var is set on the project.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=YOUR-LONG-RANDOM-SECRET

# ── App URL ───────────────────────────────────────────────────────────────────
# Local: http://localhost:3000 — Production: https://your-domain.vercel.app
# Also set this as the "Site URL" in Supabase → Auth → URL Configuration and
# add "<APP_URL>/auth/callback" to the allowed Redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI-powered parsing (optional) ─────────────────────────────────────────────
# Nudge's natural-language parser is fully rule-based and works without any AI.
# If you set an OpenAI API key, ambiguous captures are additionally interpreted
# by the AI and gracefully fall back to the rule-based parser on any error.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
